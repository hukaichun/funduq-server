# Configuration the gateway reads. Two env families now: core (funduq,
# FUNDUQ_* — read explicitly via CoreSettings.from_env) and serving
# (souk_server, SOUK_* — pydantic-settings). NOTE: nothing auto-loads
# this file — it documents what to `export` (or set in docker-compose /
# your process manager).
#
# Core (funduq — installed from PyPI; see funduq/config.py upstream)
# Unset FUNDUQ_DATABASE_URL = zero-config SQLite at ./funduq.db.
#FUNDUQ_DATABASE_URL=postgresql+psycopg://souk:souk@localhost:5433/souk
#FUNDUQ_DB_SCHEMA=public
# Required — signs session tokens and KYOK HMACs.
#FUNDUQ_TOKEN_SIGNING_SECRET=change-me
# This funduq's own Ed25519 identity (hex, 64 chars — a 32-byte seed):
# REQUIRED now. Providers pin it, the ticket handshake binds proofs to
# it, and every replica of one funduq must carry the same value.
# Generate one with:
#
#   uv run python -c "from funduq.identity import FunduqIdentity; print(FunduqIdentity.generate_hex())"
#FUNDUQ_IDENTITY_PRIVATE_KEY=

# Serving (souk_server — see souk_server/config.py). One listener carries
# everything, WebSocket relays included (docs/server-mode.md). The SOUK_
# prefix here is this repo's own and predates the funduq rename (#35).
#SOUK_HTTP_HOST=0.0.0.0
#SOUK_HTTP_PORT=8000
# URL advertised in A2A Agent Cards — what callers reach this gateway at.
#SOUK_PUBLIC_HTTP_URL=http://localhost:8000
#SOUK_CORS_ALLOW_ORIGINS=["*"]
# TLS; dev pair: uv run python scripts/gen_dev_tls_cert.py
#SOUK_HTTP_TLS_CERT_PATH=
#SOUK_HTTP_TLS_KEY_PATH=

# LLM credentials for the providers (docent, and the demo market behind
# `--profile demo`) — any OpenAI-compatible endpoint. Unlike the sections
# above, docker compose DOES read these from a `.env` beside
# docker-compose.yml (its `${...}` interpolation), which is what the
# docent service's "copy .env.example to .env" comment refers to. The
# names are read in providers/pydantic-ai-agent/pydantic_ai_agent/main.py.
#LLM_BASE_URL=https://your-endpoint.example.com/openai/v1
#LLM_API_KEY=
#LLM_MODEL_NAME=
# Or, for Anthropic directly (and set the config's `model:` accordingly):
#ANTHROPIC_API_KEY=
